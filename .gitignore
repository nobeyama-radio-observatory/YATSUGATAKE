# ---- Vivado の生成物（すべて再生成できる）----
build/
build-*/
*.jou
*.log
*.str
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.gen/
*.sim/
*.xpr
*.xsa

# ---- ビットストリームとハンドオフ ----
# リリースする .bit・.hwh は GitHub Releases に添付する（docs/release.md）。git には入れない
*.bit
# tools/release_files.py が作る Release の組
/dist/
# ビルドの出力を受けたファイル（ホームパスを含む）
make.out
*.hwh
*.ltx
*.bin

# ---- ライセンス・秘密情報（万一置いても入らないように）----
*.lic
.Xilinx/

# ---- 公開前スキャンの手元の追加パターン（環境に依る値なので入れない）----
.prepublish-patterns

# ---- 取得データ・測定の大きな記録 ----
*.npy
*.npz
*.s45
runs/**/data/
# 2G-4 の模型の出力（make model-cu の runs/model_cu.txt など。make build がその場で作る）
/hw/bits/2g-4/runs/

# ---- OS / エディタ ----
.DS_Store
*~
.vscode/
.idea/

# ---- Python ----
__pycache__/
*.pyc
# sw/pynq/build_fast.sh がボードの上で作る（s45fast.c から）
libs45fast.so
.venv/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- ボードの時刻の較正（ADR 0023。ボードの個体の値はリポジトリに戻さない）----
time_cal.json
time_cal.json.*
# TP の dBm の較正も同じ（ADR 0025）
tp_cal.json
tp_cal.json.*
